# Personyx NPM Configuration
# Standardizes package management across environments

# Package installation behavior
save-exact=true
engine-strict=true
fund=false
audit-level=moderate

# Native module compilation
rebuild-bundle=true
python=/usr/bin/python3

# Registry and caching
registry=https://registry.npmjs.org/
cache-max=2592000000
prefer-frozen-lockfile=true

# Development optimizations
progress=true
loglevel=warn

# Security
audit=true
audit-level=moderate 