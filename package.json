{
  "name": "personapulse",
  "version": "0.1.0",
  "description": "DeskResearcher - Persona-based evidence analysis for product requirements",
  "main": "dist/main/main/main.js",
  "author": "PersonaPulse Team",
  "license": "MIT",
  "homepage": "https://github.com/astrogirlnim/PersonaPulse",
  "repository": {
    "type": "git",
    "url": "git@github.com:astrogirlnim/PersonaPulse.git"
  },
  "scripts": {
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:app": "npm run start",
    "dev:main": "concurrently \"tsc -p src/main/tsconfig.json --watch\" \"tsc-alias -p src/main/tsconfig.json --watch\"",
    "dev:renderer": "vite src/renderer --port 3000",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p src/main/tsconfig.json && tsc-alias -p src/main/tsconfig.json",
    "build:renderer": "vite build src/renderer",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "clean": "rimraf dist build release",
    "typecheck": "tsc --noEmit && tsc -p src/main/tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "security:scan": "gitleaks detect --source . --no-git -v",
    "security:scan-staged": "gitleaks detect --source . --staged -v",
    "validate": "npm run typecheck && npm run lint:check && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.7.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "com.personapulse.deskresearcher",
    "productName": "PersonaPulse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
