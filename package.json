{
  "name": "personyx",
  "version": "0.1.0",
  "description": "Personyx - Persona-based evidence analysis for product requirements",
  "main": "dist/main/main/main.js",
  "author": "Personyx Team",
  "license": "MIT",
  "homepage": "https://github.com/astrogirlnim/Personyx",
  "repository": {
    "type": "git",
    "url": "git@github.com:astrogirlnim/Personyx.git"
  },
  "scripts": {
    "predev": "npm run check-node-version",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:app": "npm run start",
    "dev:main": "concurrently \"tsc -p src/main/tsconfig.json --watch\" \"tsc-alias -p src/main/tsconfig.json --watch\"",
    "dev:renderer": "vite src/renderer --port 3000",
    "prebuild": "npm run check-node-version",
    "build": "npm run build:assets && npm run build:main && npm run build:renderer",
    "build:assets": "mkdir -p dist/assets && cp assets/*.png dist/assets/ && mkdir -p build && cp assets/tray-icon.png build/icon.png && mkdir -p dist/main && cp assets/tray-icon.png dist/main/icon.png",
    "build:main": "tsc -p src/main/tsconfig.json && tsc-alias -p src/main/tsconfig.json",
    "build:renderer": "vite build src/renderer",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron . --inspect=9229 --verbose --enable-logging",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "clean": "rimraf dist build release",
    "typecheck": "tsc --noEmit && tsc -p src/main/tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix && cd functions && npm run lint",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx && cd functions && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "setup-api-key": "npm run build && node scripts/setup-api-key.js",
    "test-embedding-api": "npm run build && node scripts/test-embedding-api.js",
    "db:migrate": "drizzle-kit generate && drizzle-kit push",
    "db:validate": "npm run build:main && node scripts/validate-database.js",
    "check-node-version": "node scripts/check-node-version.js",
    "rebuild-for-electron": "electron-builder install-app-deps",
    "rebuild-for-node": "if [ \"$CI\" = \"true\" ]; then echo 'Skipping native module rebuild in CI'; else pnpm rebuild better-sqlite3 keytar --reporter=silent; fi",
    "fix-native-modules": "npm run rebuild-for-electron",
    "security:scan": "gitleaks detect --source . --no-git -v",
    "security:scan-staged": "gitleaks detect --source . --staged -v",
    "check-firebase": "node scripts/check-firebase-config.js",
    "validate": "npm run typecheck && npm run lint:check && npm run format:check && npm run test",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.10.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.0.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",
    "electron-store": "^8.1.0",
    "firebase": "^10.14.1",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "openai": "^5.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "eslint": "^8.54.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.4.0",
    "prebuild-install": "^7.1.1",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "engines": {
    "node": "20.19.2",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "20.19.2",
    "pnpm": "10.10.0"
  },
  "engineStrict": true,
  "build": {
    "appId": "com.personyx.app",
    "productName": "Personyx",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "icon": "build/icon.png",
    "publish": null,
    "generateUpdatesFilesForAllChannels": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
