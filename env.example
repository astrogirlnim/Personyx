# Firebase Configuration for Personyx
# Copy this file to .env and fill in your actual values

# Firebase Web App Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=personyx-42c74.firebaseapp.com
FIREBASE_PROJECT_ID=personyx-42c74
FIREBASE_STORAGE_BUCKET=personyx-42c74.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Cloud Functions URL (after deployment)
FIREBASE_FUNCTIONS_URL=https://us-central1-personyx-42c74.cloudfunctions.net

# Optional: OpenAI API Key for local testing
OPENAI_API_KEY=your_openai_api_key_here 